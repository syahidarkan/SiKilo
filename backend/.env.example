# ─────────────────────────────────────────────────────────────────────────────
# WASKITA backend — contoh konfigurasi.
# Salin ke `.env` (JANGAN commit `.env`). Semua variabel opsional kecuali
# yang ditandai WAJIB untuk production. Nama = field di app/core/config.py
# dalam huruf besar. Nilai list ditulis sebagai JSON.
# ─────────────────────────────────────────────────────────────────────────────

# ── Aplikasi ────────────────────────────────────────────────────────────────
APP_NAME="WASKITA API"
DEBUG=false
# development | production | test
ENVIRONMENT=development
# Muat solar engine & agen PPO saat startup (false = start lebih cepat).
PRELOAD_MODELS=true

# ── Keamanan ────────────────────────────────────────────────────────────────
# WAJIB di production (server menolak start bila kosong). Buat dengan:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Bila kosong di development, kunci acak dibuat per proses (token hangus saat restart).
SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Akun admin awal dibuat saat startup HANYA bila keduanya diisi.
# Setelah admin dibuat, nilai ini boleh dikosongkan kembali.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
# Cost factor bcrypt (4–16). 12 untuk production.
BCRYPT_ROUNDS=12
# Origin frontend yang diizinkan (JSON). Hindari "*".
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:8000"]

# ── Database ────────────────────────────────────────────────────────────────
# Default SQLite (folder data/ dibuat otomatis):
DATABASE_URL=sqlite+aiosqlite:///./data/waskita.db
# PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://waskita:GANTI_PASSWORD@localhost:5432/waskita
# Hanya berlaku untuk PostgreSQL:
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# Simpan sampel telemetri mentah tiap N detik.
TELEMETRY_RAW_KEEP_EVERY_S=10
# Device.last_seen ditulis ulang paling sering tiap N detik.
DEVICE_LAST_SEEN_UPDATE_INTERVAL_S=30

# Dipakai docker-compose.yml (service db):
POSTGRES_DB=waskita
POSTGRES_USER=waskita
POSTGRES_PASSWORD=

# ── NILM ────────────────────────────────────────────────────────────────────
NILM_MODEL_PATH=models/nilm_lgbm.pkl
NILM_METRICS_PATH=models/nilm_metrics.json
NILM_EVENT_THRESHOLD_W=50
NILM_EVENT_WINDOW_S=3
NILM_EVENT_MAX_TRANSIENT_S=20
NILM_LABEL_TOLERANCE_S=5

# ── Lokasi, cuaca & PLTS (default: Sukoharjo) ──────────────────────────────
SITE_LATITUDE=-7.68
SITE_LONGITUDE=110.83
SITE_ALTITUDE_M=103
SITE_TIMEZONE=Asia/Jakarta
USE_NASA_POWER=true
NASA_POWER_ALLOW_NETWORK=true
NASA_POWER_CACHE_DIR=data/nasa_power
NASA_POWER_TIMEOUT_S=20
# Rasio GHI aktual/clear-sky bila data NASA POWER tidak tersedia.
CLEARNESS_INDEX_FALLBACK=0.75
TWIN_VALIDATION_PATH=models/twin_validation.json
PV_TILT_DEG=10
PV_AZIMUTH_DEG=0
PV_SYSTEM_LOSSES_FRAC=0.14
PV_TEMP_COEFF_PER_C=-0.004
PV_WIND_SPEED_MS=1.0

# ── Tarif PLN ───────────────────────────────────────────────────────────────
# flat (B-1/B-2, UMKM) | tou (B-3/I-3 >200 kVA, WBP 17–22)
TARIFF_SCHEME=flat
TARIFF_GROUP=B-2
TARIFF_FLAT_IDR_PER_KWH=1444.70
TARIFF_LWBP_IDR_PER_KWH=1114.74
TARIFF_WBP_MULTIPLIER=1.5
TARIFF_WBP_START_HOUR=17
TARIFF_WBP_END_HOUR=22

# ── Operasional UMKM (default) ──────────────────────────────────────────────
WORK_START_HOUR=7
WORK_END_HOUR=17
DEFAULT_BASELOAD_W=800
DEFAULT_HABIT_START_HOUR=8

# ── Finansial PLTS ──────────────────────────────────────────────────────────
CAPEX_PER_KWP_IDR=10500000
BATTERY_CAPEX_PER_KWH_IDR=6000000
OPEX_PCT_OF_CAPEX=0.01
DISCOUNT_RATE=0.07
PANEL_LIFETIME_YEARS=25
PANEL_DEGRADATION_PER_YEAR=0.005
GRID_EMISSION_KG_PER_KWH=0.785

# ── Agen penjadwal ──────────────────────────────────────────────────────────
RL_MODEL_PATH=models/ppo_dispatcher.zip
ORTOOLS_TIME_LIMIT_S=10
N_FLEXIBLE_MACHINES=4

# ── WhatsApp & penjadwal otomatis ───────────────────────────────────────────
# none | fonnte | meta
WHATSAPP_PROVIDER=none
WHATSAPP_API_TOKEN=
# Khusus Meta Cloud API:
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_SEND_HOUR=17
WHATSAPP_SEND_MINUTE=30
# 0=Senin … 5=Sabtu
WEEKLY_REPORT_WEEKDAY=5
# Aktifkan pengiriman ringkasan harian/mingguan otomatis (APScheduler).
SCHEDULER_ENABLED=false
